# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── Segredos (TROQUE em produção: use `openssl rand -hex 32`) ────────────────
SESSION_SECRET=troque-este-segredo-de-sessao
JWT_SECRET=troque-este-segredo-do-jwt

# ── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./auth.db

# ── Tokens ───────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Google OAuth (https://console.cloud.google.com/apis/credentials) ─────────
# Redirect URI autorizada: ${BACKEND_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft / Azure AD (https://portal.azure.com → App registrations) ──────
# Redirect URI autorizada: ${BACKEND_URL}/auth/callback/microsoft
# Use 'common' p/ multi-tenant ou o tenant_id da ANEEL p/ single-tenant.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ── Login de desenvolvimento (NUNCA habilitar em produção) ───────────────────
# Emite sessão sem OAuth via POST /auth/dev-login. Útil para testes locais.
DEV_LOGIN_ENABLED=false

# ── CORS (origens permitidas, separadas por vírgula) ────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Administradores (e-mails separados por vírgula) ──────────────────────────
# No primeiro login, estes e-mails recebem is_admin=True e todos os módulos.
ADMIN_EMAILS=
